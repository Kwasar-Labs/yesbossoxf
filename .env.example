# MongoDB
MONGO_URI=mongodb://localhost:27017/yesboss

# Auth Service
AUTH_PORT=3001
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Workforce Service
WORKFORCE_PORT=3002

# Gateway
GATEWAY_PORT=3000

# API Key (for OpenClaw plugin → YesBoss service-to-service auth)
YESBOSS_API_KEY=change-me-to-a-secure-random-string

# OpenClaw Plugin
YESBOSS_API_URL=http://localhost:3000/api
