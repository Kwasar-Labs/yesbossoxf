# YesBoss Backend - Production Environment
# Copy to .env before deploying
# Generate secure values: openssl rand -hex 32

MONGO_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
YESBOSS_API_KEY=CHANGE_ME_TO_SECURE_API_KEY
KEYS_DIR=/opt/yesboss/keys

# Domain / SSL
DOMAIN=yesboss.yourdomain.com
SSL_EMAIL=admin@yourdomain.com

# OpenClaw Plugin
YESBOSS_API_URL=http://gateway:3000/api
